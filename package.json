{
  "name": "teaser-trailer",
  "version": "1.0.0",
  "private": true,
  "description": "36s vertical teaser trailer (1080x1920, 30fps) built entirely in code with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Teaser out/teaser.mp4",
    "still": "remotion still Teaser out/still.png --frame=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src remotion.config.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/layout-utils": "4.0.532",
    "@remotion/three": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
