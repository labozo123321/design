 "captions": [
  {
   "t0": 3.2,
   "t1": 5.6,
   "text": "your first night in your own room."
  },
  {
   "t0": 5.8,
   "t1": 7.9,
   "text": "she made up the knock."
  },
  {
   "t0": 10.6,
   "t1": 14.8,
   "text": "every night. even when you weren't speaking."
  },
  {
   "t0": 16.4,
   "t1": 19.0,
   "text": "eleven knocks meant come here."
  },
  {
   "t0": 19.8,
   "t1": 22.3,
   "text": "she always came."
  },
  {
   "t0": 22.8,
   "t1": 27.6,
   "text": "she got a boyfriend. you got earplugs."
  },
  {
   "t0": 28.4,
   "t1": 31.8,
   "text": "her last night home."
  },
  {
   "t0": 32.6,
   "t1": 35.8,
   "text": "you almost didn't answer."
  },
  {
   "t0": 39.0,
   "t1": 42.0,
   "text": "mom turned her room into a gym. briefly."
  },
  {
   "t0": 44.2,
   "t1": 47.2,
   "text": "there was no fight. it just got shorter."
  },
  {
   "t0": 49.8,
   "t1": 52.6,
   "text": "you both still slept on the wall side."
  },
  {
   "t0": 55.3,
   "t1": 58.3,
   "text": "this time, you knocked first."
  },
  {
   "t0": 63.0,
   "t1": 67.2,
   "text": "twelve years. twelve centimeters."
  }
 ],
